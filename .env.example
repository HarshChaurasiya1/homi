# Google Maps Platform (Optional for Live Traffic & Real-Time Business Hours)
# Obtain key at: https://console.cloud.google.com/
VITE_GOOGLE_ROUTES_API_KEY=
VITE_GOOGLE_PLACES_API_KEY=

# Open-Meteo Weather API (Optional custom endpoint; defaults to public open API)
VITE_OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Amadeus Hospitality API (Optional for Live Hotel Booking Inventory)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
