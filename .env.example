# ==============================================================================
# HOMI TRAVEL INTELLIGENCE ENGINE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Google Gemini API Key (Gemini Travel Brain for intelligent card selection & local advice)
# Obtain key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Google Maps Platform (Street View, Maps JavaScript API & Google Places)
# Obtain key at: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_ROUTES_API_KEY=
VITE_GOOGLE_PLACES_API_KEY=

# Open-Meteo Weather API (Optional custom endpoint; defaults to public open API)
VITE_OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Amadeus Hospitality API (Optional for Live Hotel Booking Inventory)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
